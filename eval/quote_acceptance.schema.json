{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic quote acceptance fixtures",
  "type": "object",
  "required": ["schema_version", "synthetic", "as_of", "sources", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "synthetic": {"const": true},
    "as_of": {"$ref": "#/$defs/utcTimestamp"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "tenant": {
      "enum": ["NHD", "HANU", "ZENA"]
    },
    "sku": {
      "type": "string",
      "pattern": "^SYN-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Z]+-pricing-v[1-9][0-9]*$"
    },
    "citation": {
      "type": "string",
      "pattern": "^[A-Z]+-pricing-v[1-9][0-9]*#[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "type": "object",
      "description": "Fixture source record. Dedicated refusal cases may each omit one price field to test incomplete input.",
      "required": ["tenant", "sku", "unit", "currency", "source_id", "paragraph_id", "version", "status", "valid_from", "valid_until", "citation"],
      "additionalProperties": false,
      "properties": {
        "tenant": {"$ref": "#/$defs/tenant"},
        "sku": {"$ref": "#/$defs/sku"},
        "unit": {"$ref": "#/$defs/token"},
        "unit_price": {"$ref": "#/$defs/decimal"},
        "minimum": {"$ref": "#/$defs/decimal"},
        "currency": {"$ref": "#/$defs/currency"},
        "source_id": {"$ref": "#/$defs/sourceId"},
        "paragraph_id": {"$ref": "#/$defs/token"},
        "version": {"$ref": "#/$defs/version"},
        "status": {
          "enum": ["approved", "revoked", "unapproved"]
        },
        "valid_from": {"$ref": "#/$defs/utcTimestamp"},
        "valid_until": {"$ref": "#/$defs/utcTimestamp"},
        "citation": {"$ref": "#/$defs/citation"}
      }
    },
    "binding": {
      "type": "object",
      "required": ["tenant", "sku", "source_id", "version"],
      "additionalProperties": false,
      "properties": {
        "tenant": {"$ref": "#/$defs/tenant"},
        "sku": {"$ref": "#/$defs/sku"},
        "source_id": {"$ref": "#/$defs/sourceId"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "context": {
      "type": "object",
      "required": ["tenant", "active_sources"],
      "additionalProperties": false,
      "properties": {
        "tenant": {"$ref": "#/$defs/tenant"},
        "active_sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/binding"}
        }
      }
    },
    "request": {
      "type": "object",
      "required": ["sku", "quantity", "unit", "currency"],
      "additionalProperties": false,
      "properties": {
        "sku": {"$ref": "#/$defs/sku"},
        "quantity": {"type": "string"},
        "unit": {"$ref": "#/$defs/token"},
        "currency": {"$ref": "#/$defs/currency"},
        "requested_tenant": {"$ref": "#/$defs/tenant"}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["source_id", "version", "citation"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"$ref": "#/$defs/sourceId"},
        "version": {"$ref": "#/$defs/version"},
        "citation": {"$ref": "#/$defs/citation"}
      }
    },
    "oracle": {
      "oneOf": [
        {
          "type": "object",
          "required": ["behavior", "reason", "total", "currency", "citation"],
          "additionalProperties": false,
          "properties": {
            "behavior": {"const": "answer"},
            "reason": {"const": "quoted"},
            "total": {"$ref": "#/$defs/decimal"},
            "currency": {"$ref": "#/$defs/currency"},
            "citation": {"$ref": "#/$defs/citation"}
          }
        },
        {
          "type": "object",
          "required": ["behavior", "reason"],
          "additionalProperties": false,
          "properties": {
            "behavior": {"const": "clarify"},
            "reason": {
              "enum": ["unknown_sku", "invalid_quantity", "currency_mismatch", "unit_mismatch"]
            }
          }
        },
        {
          "type": "object",
          "required": ["behavior", "reason"],
          "additionalProperties": false,
          "properties": {
            "behavior": {"const": "refuse"},
            "reason": {
              "enum": ["requested_tenant_mismatch", "source_tenant_mismatch", "source_expired", "source_revoked", "source_unapproved", "source_price_missing", "source_revision_mismatch", "source_unknown", "citation_mismatch"]
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "required": ["id", "scenario", "context", "request", "candidate", "oracle"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "scenario": {
          "type": "string",
          "pattern": "\\S"
        },
        "context": {"$ref": "#/$defs/context"},
        "request": {"$ref": "#/$defs/request"},
        "candidate": {
          "oneOf": [
            {"$ref": "#/$defs/candidate"},
            {"type": "null"}
          ]
        },
        "oracle": {"$ref": "#/$defs/oracle"},
        "baseline_case_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
